Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# These directories now live beside index.php and must never be served directly.
RewriteRule ^(?:app|config|cron|storage|database|docs|tests|includes)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:README\.md|SETUP\.md|package(?:-lock)?\.json)$ - [F,L,NC]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^enoughedu\.vedhant\.in$ [NC]
RewriteRule ^ https://enoughedu.vedhant.in%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "(?i)\.(sql|md|log|ini|env|bak|zip|phar)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
